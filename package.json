{
  "name": "stacks-white-paper",
  "version": "0.1.0",
  "description": "Source-audited draft specification for the Stacks Protocol and its TypeScript/Bun reference implementation",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bunpress dev",
    "build": "bunpress build",
    "preview": "bunpress preview",
    "clean": "bunpress clean",
    "evidence:sync": "bun scripts/sync-stacks-evidence.ts --write && bun scripts/sync-pantry-evidence.ts --write",
    "evidence:check": "bun scripts/sync-stacks-evidence.ts --check && bun scripts/sync-pantry-evidence.ts --check",
    "evidence:sync:pantry": "bun scripts/sync-pantry-evidence.ts --write",
    "evidence:check:pantry": "bun scripts/sync-pantry-evidence.ts --check",
    "deploy:workflow": "cloud quick-deploy --env production --site whitepaper --skip-dns-verification --force",
    "deploy": "cloud deploy --env production --site whitepaper --yes",
    "deploy:ci": "cloud deploy --env production --site whitepaper --skip-dns-verification --yes"
  },
  "devDependencies": {
    "@stacksjs/bunpress": "^0.1.20",
    "@stacksjs/ts-cloud": "^0.7.78"
  },
  "keywords": [
    "stacks",
    "typescript",
    "bun",
    "framework",
    "full-stack",
    "ai",
    "documentation",
    "white-paper"
  ],
  "author": "Stacks.js Core Team",
  "license": "MIT"
}
